/* ГЛАВНОЕ ОКНО И ФОН */
QMainWindow {
    background-color: #0d1222;
}

QWidget {
    color: #e6ecef;
    font-family: "Segoe UI", "Arial", sans-serif;
    font-size: 13px;
}

/* БЛОК С АВАТАРОМ / ГИФКОЙ */
#avatarLabel {
    background-color: #ffffff;
    border: 2px solid #527197;
    border-radius: 16px;
}

/* МЕТКИ (ТЕКСТ НАД ШКАЛАМИ) */
QLabel {
    color: #d1d8e0;
    font-weight: bold;
    font-size: 12px;
    margin-top: 4px;
    margin-bottom: 2px;
}

/* ПАНЕЛЬ УРОВНЯ */
#levelLabel {
    color: #ffd76e;
    font-size: 16px;
    font-weight: bold;
    margin-top: 0px;
    margin-bottom: 2px;
}

#clicksLabel {
    color: #a0b4c8;
    font-size: 11px;
    font-weight: normal;
    margin-top: 2px;
    margin-bottom: 6px;
}

/* ШКАЛЫ */
QProgressBar {
    background-color: #151d2a;
    border: 1px solid #3d4f66;
    border-radius: 8px;
    text-align: center;
    color: #ffffff;
    font-weight: bold;
    font-size: 11px;
    height: 18px;
}

/* Кастомные цвета для каждой шкалы */
QProgressBar#hungerBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #81c784, stop:1 #4caf50);
    border-radius: 7px;
}

QProgressBar#energyBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #4dd0e1, stop:1 #00acc1);
    border-radius: 7px;
}

QProgressBar#happinessBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #ff80ab, stop:1 #f50057);
    border-radius: 7px;
}

QProgressBar#xpBar {
    background-color: #151d2a;
    border: 1px solid #3d4f66;
    border-radius: 8px;
    text-align: center;
    color: #ffffff;
    font-weight: bold;
    font-size: 11px;
    height: 18px;
}

QProgressBar#xpBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #ffe082, stop:1 #ffb300);
    border-radius: 7px;
}

/* КНОПКИ */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ece5d8, stop:1 #c8b9a6);
    color: #3b4252;
    border: 1px solid #d3bc8e;
    border-radius: 12px;
    padding: 8px 12px;
    font-weight: bold;
    font-size: 12px;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ffffff, stop:1 #ded3c1);
    border: 1px solid #e1ceaa;
    color: #1e2530;
}

QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #a89a85, stop:1 #c8b9a6);
    border: 1px solid #bba579;
}